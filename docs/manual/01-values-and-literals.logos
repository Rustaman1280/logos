(mod values)

(test literals
  (expect (out "42\n-7\n255\n3.5\n2\n1e+300\ntrue\nfalse\nline one\nline two\n5\n")
    (code 0)
    (leaks 0))
  (let i :i64 42)
  (println i)
  (println -7)
  (let small :u8 255)
  (println (cast :i64 small))
  (println 3.5)
  (println 2.0)
  (println 1e300)
  (println true)
  (println false)
  (print "line one\n")
  (println "line two")
  (let unicode "é→")
  (println (str-len unicode)))
