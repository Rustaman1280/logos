(mod bindings)

(test bindings
  (expect (out "11\n1\n2\n1\n0\n2\n4\n3\n")
    (code 0)
    (leaks 0))
  (letmut n :i64 10)
  (set n (+ n 1))
  (println n)
  (let one :i64 1)
  (println one)
  (println (match 0 (0 (let one :i64 2) one) (_ 0)))
  (println one)
  (letmut i :i64 0)
  (while (< i 3)
    (let doubled :i64 (* i 2))
    (println doubled)
    (set i (+ i 1)))
  (println i))
