(mod memory)

(test memory
  (expect (out "9\n1\n2\n5\n")
    (code 0)
    (leaks 0))
  (letmut p (alloc :i64 3))
  (set-deref p 9)
  (set-deref (ptr-add p 1) 1)
  (set-deref (ptr-add (ptr p) 2) 2)
  (println (deref p))
  (println (deref (ptr-add p 1)))
  (println (deref (ptr-add (ptr p) 2)))
  (letmut q (alloc :i64 1))
  (set-deref q 5)
  (letmut r q)
  (println (deref r))
  (free r)
  (free p))
