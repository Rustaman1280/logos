(mod vectors)

(fn sum :i64 ((v (vec :i64)))
  (letmut i :i64 0)
  (letmut total :i64 0)
  (while (< i (vec-len v))
    (set total (+ total (vec-get v i)))
    (set i (+ i 1)))
  (vec-free v)
  (ret total))

(test vectors
  (expect (out "7\n3\n12\n")
    (code 0)
    (leaks 0))
  (letmut v
    (vec :i64)
    (make (vec :i64)))
  (vec-push v 1)
  (vec-push v 2)
  (vec-push v 3)
  (vec-set v 0 7)
  (println (vec-get v 0))
  (println (vec-len v))
  (println (sum v)))
