(mod arith)

(fn main :i64 ()
  (println (+ 17 25))
  (println (- 17 25))
  (println (* -6 7))
  (println (/ 123456789 1000))
  (println (/ -7 2))
  (println (% -7 2))
  (println (% 7 -2))
  (println (- 9223372036854775807 9223372036854775806))
  (let big :u64 18446744073709551615)
  (let two :u64 2)
  (let ten :u64 10)
  (println (+ big two))
  (println (/ big ten))
  (println (% big ten))
  (ret 3))
