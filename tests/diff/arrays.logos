(mod arrays)

(fn main :i64 ()
  (letmut values
    (arr :i64 8)
    (make (arr :i64 8) 0 0 0 0 0 0 0 0))
  (letmut i :i64 0)
  (while (< i 8)
    (arr-set values i (- (* i i) 3))
    (set i (+ i 1)))
  (letmut total :i64 0)
  (letmut largest :i64 (arr-get values 0))
  (letmut j :i64 0)
  (while (< j 8)
    (let value (arr-get values j))
    (set total (+ total value))
    (set largest (if (> value largest) value largest))
    (set j (+ j 1)))
  (println total)
  (println largest)
  (println (arr-get values 3))
  (println (arr-get values 7))
  (ret 0))
