(mod strings)

(fn main :i64 ()
  (let left "logos")
  (let right " / differential")
  (let joined (str-concat left right))
  (println joined)
  (println (str-slice joined 0 5))
  (println (str-len "é→"))
  (println (= left "logos"))
  (println (= left "logo"))
  (println (str-eq (str-slice "abcdef" 1 4) "bcd"))
  (println (str-concat "" ""))
  (print "no newline")
  (println "")
  (ret 0))
