(mod shifts)

(test left-shift
  (expect (out "8\n-9223372036854775808\n")
    (code 0))
  (println (shl 1 3))
  (println (shl 1 63)))

(test right-shift-is-arithmetic
  (expect (out "-4\n-1\n0\n")
    (code 0))
  (println (shr -16 2))
  (println (shr -1 1))
  (println (shr 1 1)))

(test right-shift-unsigned-is-logical
  (expect (out "4611686018427387900\n9223372036854775807\n")
    (code 0))
  (println (shr-u -16 2))
  (println (shr-u -1 1)))

(test count-equal-to-width-is-masked
  (expect (out "5\n-16\n1\n")
    (code 0))
  (println (shl 5 64))
  (println (shr -16 64))
  (println (shr-u 1 64)))

(test count-greater-than-width-is-masked
  (expect (out "4\n1\n")
    (code 0))
  (println (shl 1 66))
  (println (shl 1 128)))

(test narrow-width
  (expect (out "1\n1\n")
    (code 0))
  (let x :u8 1)
  (println (if (= (shl x 9) 2) 1 0))
  (println (if (= (shr-u (shl x 7) 9) 64) 1 0)))

(test shift-a-count-that-is-a-value
  (expect (out "16\n4\n")
    (code 0))
  (let a :i64 1)
  (letmut n :i64 0)
  (while (< n 4)
    (set n (+ n 1)))
  (println (shl a n))
  (println (shr 64 4)))
