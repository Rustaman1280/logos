(mod floats)

(test add-and-subtract
  (expect (out "3.75\n-0.75\n")
    (code 0))
  (let a :f64 1.5)
  (let b :f64 2.25)
  (println (+ a b))
  (println (- a b)))

(test multiply-and-divide
  (expect (out "3.375\n0.6666666666666666\n0.75\n")
    (code 0))
  (let a :f64 1.5)
  (let b :f64 2.25)
  (println (* a b))
  (println (/ a b))
  (println (/ a 2.0)))

(test compare-ordered
  (expect (out "lt\nlt\ngt\ngt\n")
    (code 0))
  (let a :f64 1.5)
  (let b :f64 2.25)
  (println (if (< a b) "lt" "ge"))
  (println (if (>= a b) "ge" "lt"))
  (println (if (> b a) "gt" "le"))
  (println (if (<= b a) "le" "gt")))

(test compare-equality
  (expect (out "eq\nne\nne\n")
    (code 0))
  (let a :f64 1.5)
  (let b :f64 2.25)
  (println (if (= a a) "eq" "ne"))
  (println (if (= a b) "eq" "ne"))
  (println (if (!= a b) "ne" "eq")))

(test division-by-zero-is-not-a-panic
  (expect (out "inf\n-inf\nne\nge\n")
    (code 0))
  (println (/ 1.0 0.0))
  (println (/ -1.0 0.0))
  (println (if (= (/ 0.0 0.0) (/ 0.0 0.0)) "eq" "ne"))
  (println (if (< (/ 0.0 0.0) 1.0) "lt" "ge")))

(test f32-arithmetic
  (expect (out "1\n0\n1\n")
    (code 0))
  (let x :f32 0.1)
  (let y :f32 3.0)
  (println (if (< (* x y) 0.5) 1 0))
  (println (if (> (* x y) 0.5) 1 0))
  (println (if (= (/ y 3.0) x) 0 1)))

(test float-loop
  (expect (out "-1.5\n-1\n-0.5\n0\n0.5\n")
    (code 0))
  (letmut sum :f64 -1.5)
  (while (< sum 1.0)
    (println sum)
    (set sum (+ sum 0.5))))
