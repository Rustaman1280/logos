(mod chan)

(fn producer :void ((out (shared (chan :i64))) (n :i64))
  (letmut i :i64 0)
  (while (< i n)
    (send out (+ i 1))
    (set i (+ i 1))))

(test pipeline
  (expect (out "500500\n")
    (code 0)
    (leaks 0))
  (letmut c (chan :i64 4))
  (letmut t (spawn producer c 1000))
  (letmut i :i64 0)
  (letmut sum :i64 0)
  (while (< i 1000)
    (set sum (+ sum (recv c)))
    (set i (+ i 1)))
  (join t)
  (println sum))

(fn bump :void ((cell (shared (ptr :i64))) (m (shared :mutex)) (n :i64))
  (letmut i :i64 0)
  (while (< i n)
    (lock m)
    (set-deref cell (+ (deref cell) 1))
    (unlock m)
    (set i (+ i 1))))

(test mutex-counter
  (expect (out "40000\n")
    (code 0)
    (leaks 0))
  (let p (alloc :i64 1))
  (set-deref (ptr p) 0)
  (letmut cell
    (shared (ptr :i64))
    (ptr p))
  (letmut m (mutex))
  (letmut ts
    (vec :thread)
    (make (vec :thread)))
  (letmut i :i64 0)
  (while (< i 4)
    (vec-push ts (spawn bump cell m 10000))
    (set i (+ i 1)))
  (letmut j :i64 0)
  (while (< j (vec-len ts))
    (join (vec-get ts j))
    (set j (+ j 1)))
  (println (deref cell))
  (vec-free ts)
  (free p))

(fn noop :void ()
  (ret))

(type pair (struct (a :i64) (b :i64)))

(fn pair-producer :void ((c (shared (chan pair))) (n :i64))
  (letmut i :i64 0)
  (while (< i n)
    (send c (make pair i (* i 2)))
    (set i (+ i 1))))

(test struct-elements
  (expect (out "90\n")
    (code 0)
    (leaks 0))
  (letmut c (chan pair 4))
  (letmut t (spawn pair-producer c 10))
  (letmut k :i64 0)
  (letmut sum :i64 0)
  (while (< k 10)
    (let p (recv c))
    (set sum (+ sum (get p b)))
    (set k (+ k 1)))
  (join t)
  (println sum))

(fn send-range :void ((c (shared (chan :i64))) (base :i64) (n :i64))
  (letmut i :i64 0)
  (while (< i n)
    (send c (+ base i))
    (set i (+ i 1))))

(test four-producers
  (expect (out "49995000\n")
    (code 0)
    (leaks 0))
  (letmut c (chan :i64 2))
  (letmut ts
    (vec :thread)
    (make (vec :thread)))
  (letmut j :i64 0)
  (while (< j 4)
    (vec-push ts (spawn send-range c (* j 2500) 2500))
    (set j (+ j 1)))
  (letmut k :i64 0)
  (letmut sum :i64 0)
  (while (< k 10000)
    (set sum (+ sum (recv c)))
    (set k (+ k 1)))
  (letmut m :i64 0)
  (while (< m (vec-len ts))
    (join (vec-get ts m))
    (set m (+ m 1)))
  (println sum)
  (vec-free ts))

(test zero-capacity
  (expect (code 2)
    (err-contains "R0003: channel capacity must be positive"))
  (letmut c (chan :i64 0))
  (send c 1))

(test double-join
  (expect (code 2)
    (err-contains "R0005: thread is not running"))
  (letmut t (spawn noop))
  (join t)
  (join t))
