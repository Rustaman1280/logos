(mod leak)

(type record (struct (tag :i32) (value :i64) (extra :i64)))

(fn consume :void ((p (own :i64)))
  (free p))

(test no-leak
  (expect (out "seven\n")
    (code 0)
    (leaks 0))
  (let p (alloc :i64 4))
  (set-deref p 7)
  (println (match (deref p) (7 "seven")
             (_ "other")))
  (free p))

(test array-elements
  (expect (out "three\n")
    (code 0)
    (leaks 0))
  (let p (alloc :i64 4))
  (set-deref (ptr-add p 2) 3)
  (println (match (deref (ptr-add p 2)) (3 "three")
             (_ "other")))
  (free p))

(test handoff
  (expect (out "ok\n")
    (code 0)
    (leaks 0))
  (letmut p (alloc :i64 2))
  (consume p)
  (println "ok"))

(test leak-reported
  (expect (code 0)
    (leaks 1)
    (err-contains "LEAK"))
  (let p (alloc :i64 4))
  (set-deref p 1))

(test zero-byte-leak
  (expect (code 0)
    (leaks 1)
    (err-contains "LEAK 0 bytes"))
  (let _ (alloc :i64 0)))

(test struct-leak
  (expect (code 0)
    (leaks 1)
    (err-contains "LEAK 24 bytes"))
  (let _ (alloc record 1)))

(test wrapped-count-panics
  (expect (code 2)
    (err-contains "R0003: allocation size overflows"))
  (let n (+ 9223372036854775807 1))
  (let _ (alloc :i64 n)))
