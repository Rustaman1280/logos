(mod wc)

(fn char-at :str ((s :str) (i :i64))
  (ret (str-slice s i (+ i 1))))

(fn is-space :bool ((c :str))
  (ret (or (= c " ")
         (or (= c "\t")
           (or (= c "\n")
             (or (= c "\r")
               (or (= c "")
                 (= c ""))))))))

(fn digit-count :i64 ((n :i64))
  (if (< n 10)
    (ret 1)
    (if (< n 100)
      (ret 2)
      (if (< n 1000)
        (ret 3)
        (if (< n 10000)
          (ret 4)
          (if (< n 100000)
            (ret 5)
            (if (< n 1000000)
              (ret 6)
              (ret 7))))))))

(fn pad :void ((n :i64))
  (letmut width (digit-count n))
  (while (< width 7)
    (print " ")
    (set width (+ width 1)))
  (print n))

(fn main :void ()
  (let text (read-all))
  (let size (str-len text))
  (letmut i :i64 0)
  (letmut lines :i64 0)
  (letmut words :i64 0)
  (letmut in-word false)
  (while (< i size)
    (let c (char-at text i))
    (let blank (is-space c))
    (set lines (if (= c "\n")
                 (+ lines 1) lines))
    (set words (if (and (not blank)
                     (not in-word))
                 (+ words 1) words))
    (set in-word (if blank false true))
    (set i (+ i 1)))
  (pad lines)
  (print " ")
  (pad words)
  (print " ")
  (pad size)
  (println ""))
