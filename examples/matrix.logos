(mod matrix)

(fn worker :void ((a (shared (ptr :i64))) (b (shared (ptr :i64))) (c (shared (ptr :i64))) (start :i64) (rows :i64) (size :i64))
  (letmut offset :i64 0)
  (while (< offset rows)
    (let row (+ start offset))
    (letmut column :i64 0)
    (while (< column size)
      (letmut index :i64 0)
      (letmut cell :i64 0)
      (while (< index size)
        (set cell (+ cell (* (deref (ptr-add a (+ (* row size) index)))
                            (deref (ptr-add b (+ (* index size) column))))))
        (set index (+ index 1)))
      (set-deref (ptr-add c (+ (* row size) column)) cell)
      (set column (+ column 1)))
    (set offset (+ offset 1))))

(fn main :void ()
  (let size :i64 200)
  (let area (* size size))
  (let quarter (/ size 4))
  (let left (alloc :i64 area))
  (let right (alloc :i64 area))
  (let product (alloc :i64 area))
  (letmut i :i64 0)
  (while (< i area)
    (let row (/ i size))
    (let column (% i size))
    (set-deref (ptr-add (ptr left) i)
      (- (% (+ (* row 7)
              (* column 3)) 19) 9))
    (set-deref (ptr-add (ptr right) i)
      (- (% (+ (* row 5)
              (* column 11)) 17) 8))
    (set i (+ i 1)))
  (let shared-left
    (shared (ptr :i64))
    (ptr left))
  (let shared-right
    (shared (ptr :i64))
    (ptr right))
  (let shared-product
    (shared (ptr :i64))
    (ptr product))
  (let first (spawn worker shared-left shared-right shared-product 0 quarter size))
  (let second (spawn worker shared-left shared-right shared-product quarter quarter size))
  (let third (spawn worker shared-left shared-right shared-product (* 2 quarter) quarter size))
  (let fourth (spawn worker shared-left shared-right shared-product (* 3 quarter) quarter size))
  (join first)
  (join second)
  (join third)
  (join fourth)
  (letmut total :i64 0)
  (letmut weighted :i64 0)
  (letmut k :i64 0)
  (while (< k area)
    (let value (deref (ptr-add shared-product k)))
    (set total (+ total value))
    (set weighted (+ weighted (* (+ k 1) value)))
    (set k (+ k 1)))
  (print "sum ")
  (println total)
  (print "weighted ")
  (println weighted)
  (print "center ")
  (println (deref (ptr-add shared-product (+ (* (/ size 2) size)
                                            (/ size 2)))))
  (print "last ")
  (println (deref (ptr-add shared-product (- area 1))))
  (free left)
  (free right)
  (free product))
