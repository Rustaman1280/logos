# Build output: the compiler writes binaries, IR (*.ll) and captured output
# (*.out) under build/, which is ignored as a whole. Those suffixes are
# deliberately not ignored globally, so a stray generated file outside build/
# shows up in git status.
build/
*.o

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/

# Agent working state
.superpowers/
